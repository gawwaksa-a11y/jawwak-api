# ============================================================
#  جوّك API — متغيّرات البيئة
#  التطوير: انسخ هذا الملف إلى .env (يعمل بلا أي قاعدة بيانات مثبّتة).
#  الإنتاج (Railway): أضف المتغيّرات من لوحة Railway → Variables.
# ============================================================

# ---------- التطبيق ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# الإنتاج: https://<portal>.vercel.app (افصل بفواصل). تطبيق الجوال لا يحتاج CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- قاعدة البيانات ----------
# التطوير: اتركه فارغاً (اكتشاف تلقائي: Postgres محلي إن وُجد، وإلا SQLite في الذاكرة).
DB_DRIVER=
SQLITE_PATH=jawwak-dev.sqlite

# Postgres محلي (اختياري):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jawwak_db
DB_USER=jawwak_user
DB_PASS=jawwak_dev_2024

# الإنتاج (Supabase): رابط واحد يكفي — يفرض Postgres ويفعّل SSL تلقائياً،
# ويطبّق الـ migrations عند الإقلاع. استخدم رابط "Session pooler" من
# Supabase → Connect (يعمل عبر IPv4؛ الرابط المباشر db.xxx قد يكون IPv6 فقط).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SSL=true

# ---------- Redis (اختياري — بدونه يُستخدم كاش داخل الذاكرة) ----------
# الإنتاج (Railway Redis): REDIS_URL له الأولوية.
# REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Firebase Admin ----------
# التطوير: اتركها فارغة (مستخدم تطوير تلقائي).
# الإنتاج: إلزامية — بدونها ترفض كل المسارات المحمية بـ 401.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ---------- الأمان ----------
# ولّد قيماً عشوائية للإنتاج:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET_KEY=change-me-dev-qr-secret-key-0001
QR_HMAC_KEY=change-me-dev-qr-hmac-key-00001

# ---------- الحدّ من المعدّل ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# الزرع التلقائي عند الإقلاع (تطوير فقط؛ يُتجاهل في الإنتاج)
SEED_ON_BOOT=true

# ---------- HyperPay (اختياري — يُعطّل الدفع عند غيابه) ----------
# Sandbox: https://eu-test.oppwa.com | Production: https://oppwa.com
HYPERPAY_BASE_URL=https://eu-test.oppwa.com
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_MADA_ENTITY_ID=
APP_BASE_URL=http://localhost:3000
